{
  "schemaVersion": 1,
  "id": "demotivator",
  "version": "${version}",
  "name": "Demotivator",
  "description": "Turns a screenshot into a classic demotivator poster with /demotivate <text>.",
  "authors": [
    "LTS_Server"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.lts.demotivator.DemotivatorClient"
    ],
    "modmenu": [
      "org.lts.demotivator.compat.DemotivatorModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-lifecycle-events-v1": "*",
    "fabric-key-mapping-api-v1": "*",
    "fabric-command-api-v2": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
